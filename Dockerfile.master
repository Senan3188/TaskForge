FROM rust:1.98-bookworm AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock README.md ./
COPY src/ src/
COPY dashboard/ dashboard/
RUN cargo build --release --locked --bin taskforge

FROM debian:bookworm-slim
COPY --from=build /build/target/release/taskforge /usr/local/bin/taskforge
WORKDIR /data
RUN chown 10001:10001 /data
USER 10001:10001
EXPOSE 7878
ENTRYPOINT ["taskforge", "master"]
CMD ["--bind", "0.0.0.0:7878", "--database", "/data/taskforge.sqlite3"]
